# Optional: als .env neben compose.yaml speichern.
# Die Vorgaben passen zur vorbereiteten zweiten Anwendung auf deinem QNAP.
LAVERNA_PORT=18081
LAVERNA_BIND_IP=0.0.0.0
LAVERNA_DOMAIN=flusensieb.dns.navy
# NAS-Port; FRITZ!Box: extern TCP 10443 -> QNAS1 TCP 20443.
LAVERNA_HTTPS_PORT=20443
# Vorhandenen RPS-Token auf dem NAS verwenden; hier keinen Tokenwert eintragen.
LAVERNA_DYNV6_TOKEN_FILE=/share/Container/rps-arena/rps-remake/secrets/dynv6_api_token

# NAS-Konten / SQLite (außerhalb des austauschbaren Programmpakets)
LAVERNA_DATA_PATH=../data
LAVERNA_PUBLIC_URL=https://flusensieb.dns.navy:10443
LAVERNA_SECURE_COOKIES=true
